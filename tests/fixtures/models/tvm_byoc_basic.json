{
  "format": "OPENNPUX_TVM_BYOC_GRAPH_V1",
  "tensors": [
    {"name": "input", "shape": [2, 4], "dtype": "float32", "storage": "input"},
    {"name": "weight", "shape": [4, 3], "dtype": "float32", "storage": "constant"},
    {"name": "bias", "shape": [2, 3], "dtype": "float32", "storage": "constant"},
    {"name": "matmul", "shape": [2, 3], "dtype": "float32", "storage": "scratch"},
    {"name": "biased", "shape": [2, 3], "dtype": "float32", "storage": "scratch"},
    {"name": "activated", "shape": [2, 3], "dtype": "float32", "storage": "scratch"},
    {"name": "probabilities", "shape": [2, 3], "dtype": "float32", "storage": "scratch"},
    {"name": "top_values", "shape": [2, 1], "dtype": "float32", "storage": "output"},
