#!/bin/sh

mkdir -p /proc /sys /tmp /dev
[ -r /proc/mounts ] || mount -t proc proc /proc 2>/dev/null || true
is_mounted() {
    while read -r _source target _rest; do
        [ "$target" = "$1" ] && return 0
    done < /proc/mounts
    return 1
}
is_mounted /sys || mount -t sysfs sysfs /sys 2>/dev/null || true
is_mounted /tmp || mount -t tmpfs tmpfs /tmp 2>/dev/null || true
is_mounted /dev || mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

NPU_BASE=0x1D000000
CORALCTL=/tmp/coralctl
MODULE=/tmp/opennpux_coral.ko
kernel_release=unknown
[ ! -r /proc/sys/kernel/osrelease ] || \
    IFS= read -r kernel_release < /proc/sys/kernel/osrelease

echo "[coral-driver-dma-test] started"
echo "[coral-driver-dma-test] tool=${CORALCTL}"
echo "[coral-driver-dma-test] kernel=${kernel_release}"

fail() {
    echo "[coral-driver-dma-test] FAIL: $*"
    if command -v m5 >/dev/null 2>&1; then
        m5 --inst exit
    fi
    exit 1
}

[ -f /tmp/coralnpu-baseline-preload.ready ] ||
    fail "stale or incomplete baseline checkpoint"
[ -x "${CORALCTL}" ] || fail "preloaded coralctl is missing"
[ -f "${MODULE}" ] || fail "preloaded kernel module is missing"
[ -x /tmp/busybox ] || fail "preloaded BusyBox is missing"

if [ ! -c /dev/opennpux-coral ]; then
    echo "[coral-driver-dma-test] loading ${MODULE}"
    /tmp/busybox insmod "${MODULE}" 2>/tmp/opennpux-coral-insmod.err || true
fi
if [ ! -c /dev/opennpux-coral ]; then
    [ ! -s /tmp/opennpux-coral-insmod.err ] ||
        while IFS= read -r line; do
            printf '%s\n' "$line"
        done < /tmp/opennpux-coral-insmod.err
    fail "/dev/opennpux-coral missing"
fi

if ! OPENNPUX_CORAL_TRANSPORT=driver "${CORALCTL}" info "${NPU_BASE}"; then
    fail "driver info failed"
fi
if ! OPENNPUX_CORAL_TRANSPORT=driver "${CORALCTL}" mem-clear "${NPU_BASE}"; then
    fail "driver shared-window mmap failed"
fi
if ! OPENNPUX_CORAL_TRANSPORT=driver "${CORALCTL}" dma-test "${NPU_BASE}"; then
    fail "driver DMA execution failed"
fi

echo "[coral-driver-dma-test] PASS"
if command -v m5 >/dev/null 2>&1; then
    m5 --inst exit
fi
exit 0
