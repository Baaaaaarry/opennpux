#!/bin/sh

mkdir -p /proc /sys /tmp /dev
[ -r /proc/mounts ] || mount -t proc proc /proc 2>/dev/null || true
is_mounted() {
    while read -r _source target _rest; do
        [ "$target" = "$1" ] && return 0
    done < /proc/mounts
    return 1
}
is_mounted /sys || mount -t sysfs sysfs /sys 2>/dev/null || true
is_mounted /tmp || mount -t tmpfs tmpfs /tmp 2>/dev/null || true
is_mounted /dev || mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

NPU_BASE=0x1D000000
CORALCTL=/tmp/coralctl
MODULE=/tmp/opennpux_coral.ko

fail() {
    echo "[coral-custom-rtl-test] FAIL: $*"
    if command -v m5 >/dev/null 2>&1; then
        m5 --inst exit
    fi
    exit 1
}

echo "[coral-custom-rtl-test] started"
[ -f /tmp/coralnpu-phase3-preload.ready ] ||
    fail "stale or incomplete checkpoint"
[ -x "${CORALCTL}" ] || fail "preloaded coralctl is missing"
[ -f "${MODULE}" ] || fail "preloaded kernel module is missing"
[ -x /tmp/busybox ] || fail "preloaded BusyBox is missing"

if [ ! -c /dev/opennpux-coral ]; then
    /tmp/busybox insmod "${MODULE}" 2>/tmp/opennpux-coral-insmod.err || true
fi
[ -c /dev/opennpux-coral ] || fail "/dev/opennpux-coral missing"

echo "[coral-custom-rtl-test] official software path"
OPENNPUX_CORAL_TRANSPORT=driver "${CORALCTL}" vector-add 16 "${NPU_BASE}" ||
    fail "official vector-add failed"

echo "[coral-custom-rtl-test] custom RTL path"
OPENNPUX_CORAL_TRANSPORT=driver "${CORALCTL}" vector-add-custom 16 "${NPU_BASE}" ||
    fail "custom RTL vector-add failed"

echo "[coral-custom-rtl-test] PASS"
if command -v m5 >/dev/null 2>&1; then
    m5 --inst exit
fi
exit 0
