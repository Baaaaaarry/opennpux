#!/bin/sh

mkdir -p /proc /sys /tmp /dev
[ -r /proc/mounts ] || mount -t proc proc /proc 2>/dev/null || true
is_mounted() {
    while read -r _source target _rest; do
        [ "$target" = "$1" ] && return 0
    done < /proc/mounts
    return 1
}
is_mounted /sys || mount -t sysfs sysfs /sys 2>/dev/null || true
is_mounted /tmp || mount -t tmpfs tmpfs /tmp 2>/dev/null || true
is_mounted /dev || mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

NPU_BASE=0x1D000000
CORALCTL=
for candidate in \
    /tmp/coralctl \
    /usr/local/bin/coralctl \
    /data/usr/local/bin/coralctl
do
    if [ -x "$candidate" ]; then
        CORALCTL="$candidate"
        break
    fi
done

echo "[coral-driver-info-test] started"
echo "[coral-driver-info-test] tool=${CORALCTL:-none}"
echo "[coral-driver-info-test] kernel=$(uname -r)"

if [ ! -f /tmp/coralnpu-phase3-preload.ready ]; then
    echo "[coral-driver-info-test] FAIL: stale or incomplete Phase-3 checkpoint"
    echo "[coral-driver-info-test] rebuild with CORAL_REBUILD_CKPT=1"
    if command -v m5 >/dev/null 2>&1; then
        m5 --inst exit
    fi
    exit 1
fi

if [ ! -c /dev/opennpux-coral ]; then
    for module in \
        /tmp/opennpux_coral.ko \
        "/lib/modules/$(uname -r)/extra/opennpux_coral.ko" \
        /root/opennpux_coral.ko
    do
        if [ -f "$module" ]; then
            echo "[coral-driver-info-test] loading $module"
            if [ -x /tmp/busybox ]; then
                /tmp/busybox insmod "$module" 2>/tmp/opennpux-coral-insmod.err || true
            elif [ -x /bin/busybox ]; then
                /bin/busybox insmod "$module" 2>/tmp/opennpux-coral-insmod.err || true
            elif command -v insmod >/dev/null 2>&1; then
                insmod "$module" 2>/tmp/opennpux-coral-insmod.err || true
            elif [ -x /sbin/insmod ]; then
                /sbin/insmod "$module" 2>/tmp/opennpux-coral-insmod.err || true
            elif command -v modprobe >/dev/null 2>&1; then
                modprobe opennpux_coral 2>/tmp/opennpux-coral-insmod.err || true
            elif [ -x /sbin/modprobe ]; then
                /sbin/modprobe opennpux_coral 2>/tmp/opennpux-coral-insmod.err || true
            else
                echo "no insmod/modprobe found in guest" > /tmp/opennpux-coral-insmod.err
            fi
            break
        fi
    done
fi

result=1
if [ -z "$CORALCTL" ]; then
    echo "[coral-driver-info-test] FAIL: coralctl is not installed"
elif [ ! -c /dev/opennpux-coral ]; then
    echo "[coral-driver-info-test] FAIL: /dev/opennpux-coral missing"
    if [ -s /tmp/opennpux-coral-insmod.err ]; then
        cat /tmp/opennpux-coral-insmod.err
    fi
    dmesg | tail -20 2>/dev/null || true
elif OPENNPUX_CORAL_TRANSPORT=driver "$CORALCTL" info "${NPU_BASE}"; then
    dmesg | grep -i "opennpux-coral" | tail -5 2>/dev/null || true
    echo "[coral-driver-info-test] PASS"
    result=0
else
    echo "[coral-driver-info-test] FAIL: driver-backed coralctl info failed"
fi

if command -v m5 >/dev/null 2>&1; then
    m5 --inst exit
fi
exit "$result"
