#!/bin/sh

mkdir -p /proc /sys /tmp /dev
[ -r /proc/mounts ] || mount -t proc proc /proc 2>/dev/null || true
is_mounted() {
    while read -r _source target _rest; do
        [ "$target" = "$1" ] && return 0
    done < /proc/mounts
    return 1
}
is_mounted /sys || mount -t sysfs sysfs /sys 2>/dev/null || true
is_mounted /tmp || mount -t tmpfs tmpfs /tmp 2>/dev/null || true
is_mounted /dev || mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
[ -c /dev/mem ] || mknod /dev/mem c 1 1 2>/dev/null || true

NPU_BASE=0x1D000000
RESET_CSR=0x1D030000
PC_START_CSR=0x1D030004
STATUS_CSR=0x1D030008
BACKEND_ID_CSR=0x1D030FFC
FIRMWARE_ENTRY_CSR=0x1D030FF8

CORALCTL=
for candidate in \
    /usr/local/bin/coralctl \
    /data/usr/local/bin/coralctl \
    /bin/coralctl \
    /data/bin/coralctl
do
    if [ -x "$candidate" ]; then
        CORALCTL="$candidate"
        break
    fi
done

MMIO32=
for candidate in \
    /usr/local/bin/mmio32 \
    /data/usr/local/bin/mmio32 \
    /bin/mmio32 \
    /data/bin/mmio32
do
    if [ -x "$candidate" ]; then
        MMIO32="$candidate"
        break
    fi
done

DEVMEM=
for candidate in /usr/bin/devmem /usr/sbin/devmem /sbin/devmem /bin/devmem; do
    if [ -x "$candidate" ]; then
        DEVMEM="$candidate"
        break
    fi
done

if [ -z "$DEVMEM" ] && command -v devmem >/dev/null 2>&1; then
    DEVMEM="$(command -v devmem)"
fi

DEVMEM_WRAPPER=
if [ -z "$DEVMEM" ] && command -v busybox >/dev/null 2>&1; then
    if busybox --list 2>/dev/null | grep -qx devmem; then
        DEVMEM_WRAPPER="busybox"
    fi
fi

if [ -z "$DEVMEM" ] && [ -z "$DEVMEM_WRAPPER" ] && command -v toybox >/dev/null 2>&1; then
    if toybox --list 2>/dev/null | grep -qx devmem; then
        DEVMEM_WRAPPER="toybox"
    fi
fi

PYTHON_BIN=
for candidate in /usr/bin/python3 /bin/python3 /usr/bin/python /bin/python; do
    if [ -x "$candidate" ]; then
        PYTHON_BIN="$candidate"
        break
    fi
done

DD_BIN=
for candidate in /bin/dd /usr/bin/dd; do
    if [ -x "$candidate" ]; then
        DD_BIN="$candidate"
        break
    fi
done

OD_BIN=
for candidate in /usr/bin/od /bin/od; do
    if [ -x "$candidate" ]; then
        OD_BIN="$candidate"
        break
    fi
done

echo "[coralnpu] bring-up script started"
echo "[coralnpu] aperture base: ${NPU_BASE}"
echo "[coralnpu] /dev/mem present: $(if [ -c /dev/mem ]; then echo yes; else echo no; fi)"
echo "[coralnpu] coralctl tool: ${CORALCTL:-none}"
echo "[coralnpu] mmio32 tool: ${MMIO32:-none}"
echo "[coralnpu] devmem tool: ${DEVMEM:-none}"
echo "[coralnpu] devmem wrapper: ${DEVMEM_WRAPPER:-none}"
echo "[coralnpu] python tool: ${PYTHON_BIN:-none}"
echo "[coralnpu] dd tool: ${DD_BIN:-none}"
echo "[coralnpu] od tool: ${OD_BIN:-none}"

if [ -n "$CORALCTL" ]; then
    if "$CORALCTL" info "${NPU_BASE}" &&
       "$CORALCTL" run "${NPU_BASE}"; then
        echo "[coralnpu] PASS: coralctl completed the NPU run"
    else
        echo "[coralnpu] FAIL: coralctl could not complete the NPU run"
    fi
    if command -v m5 >/dev/null 2>&1; then
        m5 --inst exit
    fi
    exit
fi

if [ -z "$MMIO32" ] && [ -z "$DEVMEM" ] && [ -z "$DEVMEM_WRAPPER" ] \
    && { [ -z "$PYTHON_BIN" ] || [ ! -c /dev/mem ]; } \
    && { [ -z "$DD_BIN" ] || [ -z "$OD_BIN" ] || [ ! -c /dev/mem ]; }; then
    echo "[coralnpu] ERROR: no MMIO-capable devmem path is available"
    if command -v m5 >/dev/null 2>&1; then
        m5 --inst exit
    fi
    exit 1
fi

read32() {
    if [ -n "$MMIO32" ]; then
        "$MMIO32" read "$1"
        return
    fi

    if [ -n "$DEVMEM" ]; then
        "$DEVMEM" "$1" 32
        return
    fi

    if [ -n "$DEVMEM_WRAPPER" ]; then
        "$DEVMEM_WRAPPER" devmem "$1" 32
        return
    fi

    if [ -n "$DD_BIN" ] && [ -n "$OD_BIN" ]; then
        v="$(
            "$DD_BIN" if=/dev/mem bs=1 skip=$(($1)) count=4 2>/tmp/coralnpu-dd.err \
                | "$OD_BIN" -An -tx4 -v \
                | { read word; printf '%s' "$word"; }
        )"
        if [ -z "$v" ]; then
            return 1
        fi
        printf '0x%s\n' "$v"
        return
    fi

    "$PYTHON_BIN" - "$1" <<'PY'
import mmap
import os
import struct
import sys

addr = int(sys.argv[1], 0)
page = mmap.PAGESIZE
base = addr & ~(page - 1)
offset = addr - base
fd = os.open("/dev/mem", os.O_RDWR | os.O_SYNC)
try:
    mm = mmap.mmap(fd, offset + 4, flags=mmap.MAP_SHARED,
                   prot=mmap.PROT_READ | mmap.PROT_WRITE, offset=base)
    try:
        value = struct.unpack_from("<I", mm, offset)[0]
    finally:
        mm.close()
finally:
    os.close(fd)
print(hex(value))
PY
}

write32() {
    if [ -n "$MMIO32" ]; then
        "$MMIO32" write "$1" "$2"
        return
    fi

    if [ -n "$DEVMEM" ]; then
        "$DEVMEM" "$1" 32 "$2" >/dev/null
        return
    fi

    if [ -n "$DEVMEM_WRAPPER" ]; then
        "$DEVMEM_WRAPPER" devmem "$1" 32 "$2" >/dev/null
        return
    fi

    if [ -n "$DD_BIN" ]; then
        value=$(($2))
        b0=$((value & 255))
        b1=$(((value >> 8) & 255))
        b2=$(((value >> 16) & 255))
        b3=$(((value >> 24) & 255))
        {
            printf "\\$(printf '%03o' "$b0")"
            printf "\\$(printf '%03o' "$b1")"
            printf "\\$(printf '%03o' "$b2")"
            printf "\\$(printf '%03o' "$b3")"
        } | "$DD_BIN" of=/dev/mem bs=1 seek=$(($1)) count=4 conv=notrunc 2>/tmp/coralnpu-dd.err
        return
    fi

    "$PYTHON_BIN" - "$1" "$2" <<'PY'
import mmap
import os
import struct
import sys

addr = int(sys.argv[1], 0)
value = int(sys.argv[2], 0)
page = mmap.PAGESIZE
base = addr & ~(page - 1)
offset = addr - base
fd = os.open("/dev/mem", os.O_RDWR | os.O_SYNC)
try:
    mm = mmap.mmap(fd, offset + 4, flags=mmap.MAP_SHARED,
                   prot=mmap.PROT_READ | mmap.PROT_WRITE, offset=base)
    try:
        struct.pack_into("<I", mm, offset, value)
        mm.flush()
    finally:
        mm.close()
finally:
    os.close(fd)
PY
}

BACKEND_ID="$(read32 ${BACKEND_ID_CSR})" || BACKEND_ID="<read-failed>"
case "${BACKEND_ID}" in
    0x4e505501|0x4E505501) BACKEND_NAME="stage-a" ;;
    0x4e505502|0x4E505502) BACKEND_NAME="verilated-coral" ;;
    *) BACKEND_NAME="unknown" ;;
esac

echo "[coralnpu] backend_id=${BACKEND_ID}"
echo "[coralnpu] backend=${BACKEND_NAME}"

FIRMWARE_ENTRY="$(read32 ${FIRMWARE_ENTRY_CSR})" || FIRMWARE_ENTRY="<read-failed>"
echo "[coralnpu] firmware_entry=${FIRMWARE_ENTRY}"

RESET_BEFORE="$(read32 ${RESET_CSR})" || RESET_BEFORE="<read-failed>"
STATUS_BEFORE="$(read32 ${STATUS_CSR})" || STATUS_BEFORE="<read-failed>"

echo "[coralnpu] reset_control(before)=${RESET_BEFORE}"
echo "[coralnpu] status(before)=${STATUS_BEFORE}"
if [ "${RESET_BEFORE}" = "<read-failed>" ] || [ "${STATUS_BEFORE}" = "<read-failed>" ] \
    || [ "${RESET_BEFORE}" = "0x" ] || [ "${STATUS_BEFORE}" = "0x" ]; then
    echo "[coralnpu] read error detail:"
    if [ -s /tmp/coralnpu-dd.err ]; then
        cat /tmp/coralnpu-dd.err
    fi
    echo "[coralnpu] MMIO access failed; guest lacks a working devmem/mmap path"
    if command -v m5 >/dev/null 2>&1; then
        m5 --inst exit
    fi
    exit 1
fi

if [ "${BACKEND_NAME}" = "verilated-coral" ]; then
    if [ "${FIRMWARE_ENTRY}" = "<read-failed>" ]; then
        echo "[coralnpu] FAIL: RTL firmware entry is unavailable"
        exit 1
    fi
    write32 "${PC_START_CSR}" "${FIRMWARE_ENTRY}"
else
    write32 "${PC_START_CSR}" 0x0
fi
write32 "${RESET_CSR}" 0x1
write32 "${RESET_CSR}" 0x0

status_hex=
halted=0
i=0
while [ "$i" -lt 1000 ]; do
    status_hex="$(read32 ${STATUS_CSR})" || status_hex=""
    if [ -z "$status_hex" ]; then
        echo "[coralnpu] read error detail:"
        if [ -s /tmp/coralnpu-dd.err ]; then
            cat /tmp/coralnpu-dd.err
        fi
        echo "[coralnpu] MMIO access failed during polling"
        break
    fi
    status_val=$((status_hex))
    if [ $((status_val & 0x2)) -ne 0 ]; then
        echo "[coralnpu] FAIL: Coral NPU reported an execution fault"
        break
    fi
    if [ $((status_val & 0x1)) -ne 0 ]; then
        halted=1
        break
    fi
    usleep 1000 2>/dev/null || true
    i=$((i + 1))
done

echo "[coralnpu] status(after)=${status_hex}"

if [ "$halted" -eq 1 ]; then
    echo "[coralnpu] PASS: Coral NPU MMIO is reachable and ${BACKEND_NAME} execution halted"
else
    echo "[coralnpu] FAIL: Coral NPU did not reach halted state"
fi

if command -v m5 >/dev/null 2>&1; then
    m5 --inst exit
fi
